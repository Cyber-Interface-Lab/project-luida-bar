      conditionValue: 
      _variableKeys: []
      _variableValuesList: []
    duringStateActions: []
    onStateExitedActions:
    - predefinedActionTemplate:
        actionType: Customized Action
        codeSnippet: 
        variables: []
      customAction: $.state.isTracking = false;
      isConditional: 0
      conditionVariable: 
      conditionValue: 
      _variableKeys: []
      _variableValuesList: []
  - stateID: 4
    onStateStartedActions:
    - predefinedActionTemplate:
        actionType: Customized Action
        codeSnippet: 
        variables: []
      customAction: sendSwingData();
      isConditional: 0
      conditionVariable: 
      conditionValue: 
      _variableKeys: []
